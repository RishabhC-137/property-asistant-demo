{
  "name": "@property-assistant/chat-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable React chat widget for the chatbot API, with pluggable icons and themes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build:deps": "npm run build --workspace=@property-assistant/contracts",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "npm run build:deps && tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "pretest": "npm run build:deps",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@property-assistant/contracts": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "^1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
