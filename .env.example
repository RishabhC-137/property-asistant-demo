PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=property_assistant
PGPOOL_MAX=10

MOCK_STREAM_DELAY_MS=15
GENERATION_LEASE_MS=120000

# Leave empty to use Gemini when GEMINI_API_KEY is set; otherwise the local mock provider is used.
CHAT_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
PROPERTY_SOURCE=fixtures

CORS_ORIGINS=http://localhost:5173
CHAT_AUTH_SECRET=
LEADS_MODE=disabled
